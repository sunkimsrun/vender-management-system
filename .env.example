JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=auth-system
JWT_AUDIENCE=auth-system-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
APP_ORIGIN=http://localhost:3000
# Set to true ONLY behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
DB_HOST=localhost
DB_PORT=3306
DB_NAME=vendor_management_system
DB_USER=vendor_app
DB_PASSWORD=replace-with-the-same-strong-password-used-in-db-schema

# Required to enable /admin/register (20+ chars). Leave empty to disable admin sign-up.
ADMIN_INVITE_CODE=

# Same registration page, but this code creates a STAFF account (20+ chars, must differ from the admin code).
STAFF_INVITE_CODE=
